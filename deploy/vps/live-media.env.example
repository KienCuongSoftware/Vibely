# LIVE media (phase 3) — append these to /opt/vibely/vibely.env (backend container env).
# The backend never carries video; it only authorizes SRS hooks and hands out WHIP/WHEP URLs.

LIVE_MEDIA_ENABLED=true

# SRS HTTP API, reachable only on this host (see SRS_HTTP_API_LISTEN in srs.env).
LIVE_MEDIA_API_URL=http://127.0.0.1:1985
# LIVE_MEDIA_API_USERNAME=
# LIVE_MEDIA_API_PASSWORD=

# Leave empty: browsers call /rtc/v1/whip/ and /rtc/v1/whep/ on the site origin (host nginx proxies them).
# Set to e.g. https://media.example.com only if a dedicated media origin is configured later.
LIVE_MEDIA_PUBLIC_URL=

# Same value as hook_token in srs.env. Generate: openssl rand -hex 32
LIVE_MEDIA_HOOK_TOKEN=<random 64 hex chars>
# HMAC key for playback tokens (stable across restarts). Generate: openssl rand -hex 32
LIVE_MEDIA_TOKEN_SECRET=<random 64 hex chars>

# Timeouts (seconds) — tune without code changes.
LIVE_MEDIA_RECONNECT_GRACE_SECONDS=60
LIVE_MEDIA_PUBLISH_START_TIMEOUT_SECONDS=180
LIVE_MEDIA_PUBLISH_TOKEN_TTL_SECONDS=300
LIVE_MEDIA_PLAYBACK_TOKEN_TTL_SECONDS=120

# ICE servers handed to browsers (comma-separated). SRS has a public IP, so STUN/TURN are optional.
# TURN is not deployed in phase 3; never put a TURN credential here unless a TURN server exists.
LIVE_MEDIA_STUN_URLS=
LIVE_MEDIA_TURN_URLS=
LIVE_MEDIA_TURN_USERNAME=
LIVE_MEDIA_TURN_CREDENTIAL=

# --- Phase 4 ---
# Hard limit on LIVE length; the scheduler ends longer LIVEs (end reason max_duration). 0 = no limit.
LIVE_MAX_DURATION_MINUTES=240

# Recording -> private draft video (needs S3, plus DVR + on_dvr in srs.env and the shared volume).
LIVE_RECORDING_ENABLED=false
LIVE_RECORDING_DVR_DIR=/var/lib/vibely/live-dvr
# Replays longer than this are cut (the video pipeline accepts < 1 hour).
LIVE_RECORDING_MAX_REPLAY_SECONDS=3600
# DVR files not claimed by any recording are deleted after this many hours.
LIVE_RECORDING_ORPHAN_FILE_RETENTION_HOURS=24

# HLS fallback for viewers without working WebRTC (needs HLS in srs.env and the nginx /live-hls/ block).
LIVE_HLS_ENABLED=false
LIVE_HLS_PUBLIC_PATH=/live-hls/
LIVE_HLS_TOKEN_TTL_SECONDS=21600
