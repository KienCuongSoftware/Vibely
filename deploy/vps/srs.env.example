# /opt/vibely/srs.env — environment for the vibely-srs container (never commit the real file).
# Copy to /opt/vibely/srs.env and replace every <...> value.

# Public IPv4 of this VPS, announced to browsers in the SDP answer. Must be an IP (Firefox rejects names).
# Cloudflare cannot proxy WebRTC UDP, so this is the server's real address.
CANDIDATE=<VPS_PUBLIC_IPV4>

# Keep SRS control ports private: only the backend (hooks/API) and host nginx (WHIP/WHEP) reach them.
SRS_HTTP_API_LISTEN=127.0.0.1:1985
SRS_LISTEN=127.0.0.1:1935

# Backend hook endpoint. <LIVE_MEDIA_HOOK_TOKEN> must equal LIVE_MEDIA_HOOK_TOKEN in vibely.env
# (generate with: openssl rand -hex 32).
SRS_VHOST_HTTP_HOOKS_ON_PUBLISH=http://127.0.0.1:8080/api/internal/live/media/srs-hooks?hook_token=<LIVE_MEDIA_HOOK_TOKEN>
SRS_VHOST_HTTP_HOOKS_ON_UNPUBLISH=http://127.0.0.1:8080/api/internal/live/media/srs-hooks?hook_token=<LIVE_MEDIA_HOOK_TOKEN>
SRS_VHOST_HTTP_HOOKS_ON_PLAY=http://127.0.0.1:8080/api/internal/live/media/srs-hooks?hook_token=<LIVE_MEDIA_HOOK_TOKEN>
SRS_VHOST_HTTP_HOOKS_ON_STOP=http://127.0.0.1:8080/api/internal/live/media/srs-hooks?hook_token=<LIVE_MEDIA_HOOK_TOKEN>

# Optional: Basic auth on the SRS HTTP API (does not affect WHIP/WHEP). If enabled, set the same
# values as LIVE_MEDIA_API_USERNAME / LIVE_MEDIA_API_PASSWORD in vibely.env.
# SRS_HTTP_API_AUTH_ENABLED=on
# SRS_HTTP_API_AUTH_USERNAME=<username>
# SRS_HTTP_API_AUTH_PASSWORD=<password>
