# Copy to credentials.local.properties and fill in values.
# Account A
test.user.email=
test.user.password=
test.user.username=

# Account B (DM peer)
test.user.b.email=
test.user.b.password=
test.user.b.username=

# Absolute path to a short local video (.mp4 / .mov / .webm) for upload tests.
test.video.path=

# Optional signup overrides (defaults: unique email/username, AutoTest@1234).
# On local, OTP usually comes from demoCode in the UI status when mail is off.
# test.signup.email=
# test.signup.password=AutoTest@1234
# test.signup.username=
# test.signup.otp=
# test.signup.email.prefix=vibely.auto

# Optional: pause after each click/type (ms). Overrides config.properties.
# action.delay.ms=2500
